# Server
SERVER_PORT=3000
NODE_ENV=development

# Milvus SDK logging
PHIGENT_LOG_LEVEL=info
ATTU_LOG_LEVEL=info

# Default Milvus connection shown in the client
MILVUS_URL=127.0.0.1:19530
DATABASE=default
MILVUS_SERVERS=

# Runtime host used by client in production
HOST_URL=

# Optional TLS files for Milvus
ROOT_CERT_PATH=
PRIVATE_KEY_PATH=
CERT_CHAIN_PATH=
SERVER_NAME=

# Optional git-index-service endpoint
GIT_INDEX_HOST=
GIT_INDEX_PORT=8795
